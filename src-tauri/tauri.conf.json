{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LexAI",
  "version": "0.1.0",
  "identifier": "pe.lexai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LexAI — Copiloto Legal Inteligente",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "connect-src": "'self' https://*.supabase.co https://www.googleapis.com https://oauth2.googleapis.com https://gmail.googleapis.com https://accounts.google.com https://generativelanguage.googleapis.com https://api.anthropic.com https://lexai-omega.vercel.app https://graph.microsoft.com https://login.microsoftonline.com ipc: http://ipc.localhost",
        "img-src": "'self' data: https: asset: http://asset.localhost",
        "font-src": "'self' https://fonts.gstatic.com https://fonts.googleapis.com",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "media-src": "'none'"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
